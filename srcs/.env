# Replace LOGIN with your 42 login (no angle brackets)
LOGIN=ytop
DOMAIN_NAME=ytop.42.fr

# MariaDB vars (note: actual secret values should be placed into ./secrets/*.txt)
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
# MYSQL_PASSWORD and MYSQL_ROOT_PASSWORD are provided via docker secrets (see secrets/)

# WordPress
WP_TABLE_PREFIX=wp_
WP_PORT=9000
